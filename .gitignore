# ==============================================================================
# SurveX Mark IV — Monorepo Git Ignore Rules
# ==============================================================================

# ── Environment & Security ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# ── Node.js / React / Frontend ────────────────────────────────────────────────
node_modules/
client/node_modules/
dist/
dist-ssr/
client/dist/
client/dist-ssr/
.next/
out/
.nuxt/
.cache/
.vite/
client/.vite/
*.tsbuildinfo

# ── Package Manager Logs & Lock Override (optional) ─────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python / Virtual Environments ────────────────────────────────────────────
.venv/
venv/
env/
ENV/
server/.venv/
server/venv/
server/env/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*/*/*/*/__pycache__/
*.py[cod]
*$py.class
.Python
server/build/
server/dist/
server/*.egg-info/
.eggs/
*.egg

# ── Database & Storage ───────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
*.log
server/logs/
client/logs/

# ── Testing & Coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.coverage.*
coverage/
client/coverage/

# ── IDE & Editor Configuration ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS Generated Files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
