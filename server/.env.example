# SurveX Virtual Robot — Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Robot ─────────────────────────────────────────────
ROBOT_NAME=Surya
ROBOT_PERSONALITY=helpful, warm, curious, and professional

# ── Server ────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# ── Knowledge Base ────────────────────────────────────
KNOWLEDGE_PATH=./knowledge
TOP_K_DOCS=2

# ── History ───────────────────────────────────────────
MAX_HISTORY_TURNS=10

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
